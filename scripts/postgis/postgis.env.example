# Copy to .env.postgis in the repository root (gitignored) and set a password.
# The same file configures docker-compose.postgis.yml and the tile factory.
SURROGATE_POSTGIS_HOST=127.0.0.1
SURROGATE_POSTGIS_PORT=5432
SURROGATE_POSTGIS_DB=surrogate_postgis
SURROGATE_POSTGIS_USER=surrogate
SURROGATE_POSTGIS_PASSWORD=
